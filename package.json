{
  "name": "sergi-tugas-art-studio",
  "version": "0.1.0",
  "description": "Sergi Tugas Art Studio — artist portfolio, Art Mail Club and art shop.",
  "type": "module",
  "private": true,
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "start": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@nuxtjs/i18n": "^10.6.0",
    "gsap": "^3.15.1",
    "nuxt": "^4.7.0",
    "vue": "^3.5.46",
    "vue-router": "^5.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@tailwindcss/vite": "^4.3.5",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vitest": "^5.1.2",
    "vue-tsc": "^3.3.14"
  }
}

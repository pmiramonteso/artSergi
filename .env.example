# Copy to `.env` for local development. Never commit `.env`.
# Every NUXT_* variable maps to `runtimeConfig` in nuxt.config.ts.
# NUXT_PUBLIC_* values are sent to the browser — never put secrets in them.

# Absolute site origin for this environment (no trailing slash).
# Leave empty locally; set it in the hosting panel per environment.
NUXT_PUBLIC_SITE_URL=

# `true` ONLY on the final production deployment. Anything else sends
# `X-Robots-Tag: noindex, nofollow` so previews are never indexed.
NUXT_PUBLIC_SITE_INDEXABLE=false

# Server port/host (read by the Nitro node-server output).
# PORT=3000
# HOST=0.0.0.0

# Newsletter provider (empty = sign-up shows "opens soon", nothing is stored).
NUXT_NEWSLETTER_PROVIDER=

# Trust X-Forwarded-For for client IPs. Only `true` behind a proxy that sets it.
NUXT_TRUST_PROXY=false

# PostgreSQL (server-only). Empty = static content, no commerce.
# Local: docker compose up -d  →  postgres://artsergi:artsergi@localhost:5432/artsergi
NUXT_DATABASE_URL=

# --- Commerce (Stripe) -------------------------------------------------------
# 'off' | 'test' | 'live'. Use 'test' with TEST keys only (sk_test_…).
# 'live' is refused unless keys are live AND pricing is validated/published.
NUXT_COMMERCE_MODE=off
NUXT_PUBLIC_COMMERCE_MODE=off
# Stripe Dashboard → Developers → API keys (TEST mode). Never commit real values.
NUXT_STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe` (local)
# or the webhook endpoint settings in the Stripe Dashboard.
NUXT_STRIPE_WEBHOOK_SECRET=
# Comma-separated ISO country codes for shipping address collection (provisional).
NUXT_SHIPPING_COUNTRIES=ES

# --- Reserved for later phases (do not fill yet) ---------------------------
# Phase 9: NUXT_SESSION_PASSWORD=
